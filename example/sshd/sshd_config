Subsystem	sftp /usr/local/libexec/sftp-server

AllowGroups	staff backup
HostCertificate	/usr/local/etc/ssh/ssh_host_rsa_key-cert.pub
HostCertificate	/usr/local/etc/ssh/ssh_host_ed25519_key-cert.pub
TrustedUserCAKeys	/usr/local/etc/ssh/server_ca.pub
PasswordAuthentication	yes	# should be paired with 2FA

HostKeyAlgorithms	ssh-ed25519-cert-v01@openssh.com,rsa-sha2-512-cert-v01@openssh.com,rsa-sha2-256-cert-v01@openssh.com,ssh-rsa-cert-v01@openssh.com,ssh-ed25519,rsa-sha2-512,rsa-sha2-256,ssh-rsa
KexAlgorithms	mlkem768x25519-sha256,sntrup761x25519-sha512,sntrup761x25519-sha512@openssh.com
Ciphers	chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs	hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com,umac-128-etm@openssh.com

LoginGraceTime	0 # Mitigate CVE-2024-6387
